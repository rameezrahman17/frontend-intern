"/* Floating party element background animations */\n@keyframes floatUp {\n  0% {\n    transform: translateY(100vh) scale(0) rotate(0deg);\n    opacity: 0;\n  }\n  10% {\n    opacity: 0.35;\n  }\n  90% {\n    opacity: 0.35;\n  }\n  100% {\n    transform: translateY(-10vh) scale(1) rotate(360deg);\n    opacity: 0;\n  }\n}\n\n.floating-party-element {\n  position: fixed;\n  bottom: -50px;\n  pointer-events: none;\n  z-index: 0;\n  animation: floatUp 15s linear infinite;\n  opacity: 0;\n}\n\n/* Party bunting decorations */\n.bunting-rope {\n  stroke: #7A1B3A;\n  stroke-width: 1.5;\n  stroke-dasharray: 4 4;\n  fill: none;\n}"